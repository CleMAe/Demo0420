# 门户显示名称（登录页、工作台、详情页标题与顶栏；与 FastAPI 文档标题一致）
PORTAL_BRAND_NAME=智能体Demo平台

# 生产环境请设置为强随机字符串，不要提交真实密钥。
JWT_SECRET=change-me

# DeepSeek 大模型配置（智能办公智能体、客服话术优化等模块共用）；不要提交真实 API Key。
# Docker：复制为 .env 后填写，执行 docker compose up --build
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=20
